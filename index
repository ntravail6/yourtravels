<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wanderlog — your travels, mapped</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --font: 'Futura', 'Futura PT', 'Futura Std', 'Jost', 'Century Gothic', 'Trebuchet MS', sans-serif;

    --bg: #faf5e8;
    --surface: #fdfaef;
    --surface-2: #ffffff;
    --text: #3d2e1f;
    --text-muted: #8a7a68;
    --border: rgba(60, 40, 25, 0.10);
    --border-strong: rgba(60, 40, 25, 0.20);
    --land: #eae1cc;
    --land-hover: #d8cdb2;

    /* Visit tiers — darker with more visits */
    --v1: #c48a68;   /* 1 visit — light sepia */
    --v2: #a67150;   /* 2 visits */
    --v3: #8b5a3f;   /* 3 visits — medium */
    --v4: #6b4230;   /* 4+ visits — deepest */

    --visited: var(--v2);
    --visited-hover: #b57e5c;
    --accent: #b89b7a;
  }

  html, body { background: var(--bg); }

  body {
    font-family: var(--font);
    color: var(--text);
    min-height: 100vh;
    padding: 32px 16px 48px;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    font-weight: 400;
    background-image:
      radial-gradient(ellipse 900px 500px at 50% -150px, rgba(139, 90, 63, 0.05) 0%, transparent 60%),
      radial-gradient(ellipse 700px 400px at 90% 20%, rgba(184, 155, 122, 0.05) 0%, transparent 60%);
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
  }

  header {
    text-align: center;
    margin-bottom: 32px;
  }

  .brand {
    font-family: var(--font);
    font-size: 42px;
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1;
    margin-bottom: 12px;
  }

  .brand em {
    font-style: normal;
    color: var(--v3);
    font-weight: 500;
  }

  .tagline {
    font-size: 10.5px;
    color: var(--text-muted);
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 500;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 28px 0 20px;
  }

  .stat {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: 16px;
    padding: 18px 8px 14px;
    text-align: center;
    transition: border-color 0.3s;
  }

  .stat:hover { border-color: var(--border-strong); }

  .stat-num {
    font-family: var(--font);
    font-size: 32px;
    font-weight: 400;
    line-height: 1;
    color: var(--v3);
    margin-bottom: 10px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 9px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 500;
  }

  .map-wrap {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: 20px;
    padding: 12px 6px 6px;
    margin-bottom: 12px;
    position: relative;
    overflow: hidden;
  }

  #map { width: 100%; height: auto; display: block; }

  .country {
    fill: var(--land);
    stroke: var(--bg);
    stroke-width: 0.4;
    cursor: pointer;
    transition: fill 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .country:hover { fill: var(--land-hover); }
  .country.v1 { fill: var(--v1); }
  .country.v2 { fill: var(--v2); }
  .country.v3 { fill: var(--v3); }
  .country.v4 { fill: var(--v4); }
  .country.v1:hover { fill: #d19a78; }
  .country.v2:hover { fill: #b57e5c; }
  .country.v3:hover { fill: #9c6a4d; }
  .country.v4:hover { fill: #7b503d; }

  @keyframes pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.03); }
    100% { transform: scale(1); }
  }

  .country.just-added {
    animation: pop 0.5s ease;
    transform-origin: center;
    transform-box: fill-box;
  }

  .legend {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 8px 0 20px;
    flex-wrap: wrap;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9.5px;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 500;
  }

  .legend-swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 0.5px solid var(--border);
  }

  .hint {
    text-align: center;
    font-size: 10.5px;
    color: var(--text-muted);
    margin: 4px 0 20px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 400;
  }

  .recent { margin-top: 8px; }

  .recent-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .recent-title {
    font-family: var(--font);
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .recent-count {
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
  }

  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    background: var(--surface);
    border: 0.5px solid var(--border);
    padding: 8px 12px 8px 12px;
    border-radius: 100px;
    font-size: 12.5px;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 400;
    cursor: pointer;
    transition: border-color 0.2s;
    animation: chipIn 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .chip:hover { border-color: var(--border-strong); }

  @keyframes chipIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--v2);
    flex-shrink: 0;
  }

  .chip-count {
    background: rgba(60, 40, 25, 0.06);
    padding: 2px 7px;
    border-radius: 100px;
    font-size: 10.5px;
    font-weight: 500;
    color: var(--v3);
    margin-left: 2px;
  }

  .actions {
    margin-top: 28px;
    display: flex;
    justify-content: center;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-muted);
    border: none;
    padding: 8px 14px;
    font-size: 10.5px;
    cursor: pointer;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: color 0.2s;
    font-family: var(--font);
    font-weight: 500;
  }

  .btn-ghost:hover { color: var(--text); }

  .loading {
    text-align: center;
    padding: 100px 0;
    color: var(--text-muted);
    font-size: 10.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
  }

  .loading .dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    background: var(--v2);
    border-radius: 50%;
    margin: 0 3px;
    animation: dotPulse 1.4s infinite ease-in-out;
    vertical-align: middle;
  }
  .loading .dot:nth-child(2) { animation-delay: 0.2s; }
  .loading .dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dotPulse {
    0%, 60%, 100% { opacity: 0.2; transform: scale(0.8); }
    30% { opacity: 1; transform: scale(1); }
  }

  footer {
    text-align: center;
    margin-top: 40px;
    font-size: 9.5px;
    color: var(--text-muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
    opacity: 0.6;
  }

  /* ── Bottom Sheet ───────────────────────────────────── */

  .sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(60, 40, 25, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    z-index: 200;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .sheet-backdrop.show {
    opacity: 1;
    pointer-events: auto;
  }

  .sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--surface);
    border-radius: 24px 24px 0 0;
    padding: 8px 20px 32px;
    padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px));
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 201;
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 0 -12px 40px rgba(60, 40, 25, 0.15);
    border-top: 0.5px solid var(--border-strong);
  }

  .sheet.show { transform: translateY(0); }

  .sheet-handle {
    width: 40px;
    height: 4px;
    background: rgba(60, 40, 25, 0.15);
    border-radius: 2px;
    margin: 8px auto 20px;
  }

  .sheet-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .sheet-country {
    font-family: var(--font);
    font-size: 26px;
    font-weight: 400;
    color: var(--text);
    line-height: 1.1;
    letter-spacing: -0.01em;
    flex: 1;
    min-width: 0;
    word-wrap: break-word;
  }

  .sheet-close {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 26px;
    cursor: pointer;
    padding: 4px 8px;
    line-height: 1;
    font-family: inherit;
    flex-shrink: 0;
  }

  .sheet-close:hover { color: var(--text); }

  .sheet-count {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
    margin-top: 6px;
  }

  .sheet-count strong {
    font-weight: 500;
    color: var(--v3);
    font-size: 14px;
    letter-spacing: 0;
  }

  .visit-list {
    margin: 22px 0 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .visit-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 12px 12px 14px;
    background: var(--bg);
    border-radius: 10px;
    border: 0.5px solid var(--border);
  }

  .visit-item-info {
    flex: 1;
    min-width: 0;
  }

  .visit-date {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 2px;
  }

  .visit-date.no-date {
    color: var(--text-muted);
    font-weight: 400;
    font-style: italic;
  }

  .visit-note {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  .visit-delete {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 22px;
    cursor: pointer;
    padding: 2px 8px;
    line-height: 1;
    font-family: inherit;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .visit-delete:hover { color: var(--v3); }

  .empty-visits {
    text-align: center;
    padding: 20px 0;
    color: var(--text-muted);
    font-size: 10.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
  }

  .add-visit-btn {
    width: 100%;
    background: var(--v3);
    color: white;
    border: none;
    padding: 14px;
    border-radius: 12px;
    font-family: var(--font);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s;
  }

  .add-visit-btn:hover { background: #9c6a4d; }

  .add-form {
    background: var(--bg);
    border-radius: 12px;
    padding: 16px;
    display: none;
    flex-direction: column;
    gap: 12px;
    border: 0.5px solid var(--border);
  }

  .add-form.open { display: flex; }

  .field-label {
    font-size: 9.5px;
    color: var(--text-muted);
    letter-spacing: 1.8px;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 6px;
    display: block;
  }

  .add-form input {
    width: 100%;
    padding: 10px 12px;
    background: var(--surface);
    border: 0.5px solid var(--border-strong);
    border-radius: 8px;
    font-family: var(--font);
    font-size: 14px;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s;
  }

  .add-form input:focus { border-color: var(--v3); }

  .form-actions {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .form-actions button {
    flex: 1;
    padding: 12px;
    border-radius: 8px;
    font-family: var(--font);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    border: none;
    transition: background 0.2s, color 0.2s;
  }

  .btn-save {
    background: var(--v3);
    color: white;
  }

  .btn-save:hover { background: #9c6a4d; }

  .btn-cancel {
    background: transparent;
    color: var(--text-muted);
    border: 0.5px solid var(--border-strong);
  }

  .btn-cancel:hover { color: var(--text); }

  @media (min-width: 640px) {
    .brand { font-size: 52px; }
    .stat-num { font-size: 38px; }
    .sheet {
      max-width: 480px;
      left: 50%;
      transform: translate(-50%, 100%);
      border-radius: 24px;
      bottom: 24px;
    }
    .sheet.show { transform: translate(-50%, 0); }
  }
</style>
</head>
<body>

<div class="container">
  <header>
    <h1 class="brand">Wander<em>log</em></h1>
    <p class="tagline">Your travels · Mapped</p>
  </header>

  <div class="stats">
    <div class="stat">
      <div class="stat-num" id="country-count">0</div>
      <div class="stat-label">Countries</div>
    </div>
    <div class="stat">
      <div class="stat-num" id="trip-count">0</div>
      <div class="stat-label">Trips</div>
    </div>
    <div class="stat">
      <div class="stat-num" id="continent-count">0</div>
      <div class="stat-label">Continents</div>
    </div>
  </div>

  <div class="map-wrap">
    <div class="loading" id="loading">
      Loading world <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    </div>
    <svg id="map" style="display:none"></svg>
  </div>

  <div class="legend">
    <div class="legend-item"><span class="legend-swatch" style="background:var(--v1)"></span>1</div>
    <div class="legend-item"><span class="legend-swatch" style="background:var(--v2)"></span>2</div>
    <div class="legend-item"><span class="legend-swatch" style="background:var(--v3)"></span>3</div>
    <div class="legend-item"><span class="legend-swatch" style="background:var(--v4)"></span>4+ trips</div>
  </div>

  <p class="hint">Tap any country to add a trip</p>

  <div class="recent" id="recent-section" style="display:none">
    <div class="recent-header">
      <h3 class="recent-title">Places you've been</h3>
      <span class="recent-count" id="recent-count"></span>
    </div>
    <div class="chip-list" id="chip-list"></div>
  </div>

  <div class="actions">
    <button class="btn-ghost" id="reset">Reset map</button>
  </div>

  <footer>Demo · Made with D3</footer>
</div>

<!-- Bottom sheet -->
<div class="sheet-backdrop" id="sheet-backdrop"></div>
<div class="sheet" id="sheet" role="dialog" aria-modal="true">
  <div class="sheet-handle"></div>
  <div class="sheet-header">
    <h2 class="sheet-country" id="sheet-country">Country</h2>
    <button class="sheet-close" id="sheet-close" aria-label="Close">×</button>
  </div>
  <div class="sheet-count" id="sheet-count-wrap"><strong id="sheet-count-num">0</strong> <span id="sheet-count-label">visits</span></div>

  <div class="visit-list" id="visit-list"></div>

  <button class="add-visit-btn" id="add-visit-btn">+ Add trip</button>

  <div class="add-form" id="add-form">
    <div>
      <label class="field-label" for="visit-date">Date (optional)</label>
      <input type="date" id="visit-date">
    </div>
    <div>
      <label class="field-label" for="visit-note">Memory (optional)</label>
      <input type="text" id="visit-note" placeholder="e.g. Cherry blossoms in Kyoto" maxlength="80">
    </div>
    <div class="form-actions">
      <button class="btn-cancel" id="cancel-visit">Cancel</button>
      <button class="btn-save" id="save-visit">Add trip</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/topojson-client/3.1.0/topojson-client.min.js"></script>
<script>
(function() {
  const STORAGE_KEY = 'wanderlog-v2';
  const SEEDED_KEY = 'wanderlog-seeded-v2';

  const continentGroups = {
    AF: ['12','24','72','108','120','132','140','148','174','180','204','226','231','232','262','266','270','288','324','384','404','426','430','434','450','454','466','478','480','504','508','516','562','566','624','646','686','690','694','706','710','716','728','729','732','736','748','768','788','800','818','834','854'],
    AS: ['4','31','50','51','64','96','104','116','144','156','196','268','275','344','356','360','364','368','376','392','398','400','408','410','414','417','418','422','458','462','496','512','524','586','608','626','634','643','682','702','704','760','762','764','784','792','795','860','887'],
    EU: ['8','20','40','56','70','100','112','191','203','208','233','246','250','276','300','336','348','352','372','380','428','438','440','442','470','492','498','499','528','578','616','620','642','674','688','703','705','724','752','756','804','807','826'],
    NA: ['28','44','52','84','124','188','192','212','214','222','308','320','332','340','388','484','558','591','630','659','662','670','780','840'],
    SA: ['32','68','76','152','170','218','238','254','328','600','604','740','858','862'],
    OC: ['36','90','242','258','296','316','520','540','548','554','570','580','585','598','612','772','776','798','876','882'],
    AN: ['10']
  };
  const idToContinent = {};
  Object.entries(continentGroups).forEach(([cont, ids]) => {
    ids.forEach(id => { idToContinent[id] = cont; });
  });

  // ── State ─────────────────────────────────────────────
  let visits = [];
  let firstEverLoad = false;
  try {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored) visits = JSON.parse(stored);
    if (!localStorage.getItem(SEEDED_KEY)) {
      firstEverLoad = true;
      localStorage.setItem(SEEDED_KEY, '1');
    }
  } catch(e) {
    firstEverLoad = visits.length === 0;
  }

  function gid() {
    return 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
  }

  if (firstEverLoad && visits.length === 0) {
    visits = [
      { id: gid(), countryId: '392', countryName: 'Japan', date: '2024-05-10', note: 'Kyoto & Osaka' },
      { id: gid(), countryId: '392', countryName: 'Japan', date: '2025-03-22', note: 'Sakura in Tokyo' },
      { id: gid(), countryId: '250', countryName: 'France', date: '2023-09-04', note: 'Paris' },
      { id: gid(), countryId: '380', countryName: 'Italy', date: '2024-11-18', note: 'Rome & Florence' },
      { id: gid(), countryId: '840', countryName: 'United States of America', date: '', note: '' },
      { id: gid(), countryId: '764', countryName: 'Thailand', date: '2024-01-05', note: 'Bangkok' }
    ];
    save();
  }

  function save() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(visits)); } catch(e) {}
  }

  function visitsFor(id) {
    return visits.filter(v => String(v.countryId) === String(id));
  }
  function countFor(id) {
    return visitsFor(id).length;
  }
  function tierFor(count) {
    if (count >= 4) return 'v4';
    if (count === 3) return 'v3';
    if (count === 2) return 'v2';
    if (count === 1) return 'v1';
    return '';
  }
  function updateCountryPath(id) {
    const path = d3.select(`.country[data-id="${id}"]`);
    if (path.empty()) return;
    path.classed('v1 v2 v3 v4', false);
    const tier = tierFor(countFor(id));
    if (tier) path.classed(tier, true);
  }

  // ── Map ───────────────────────────────────────────────
  const width = 900;
  const height = 460;
  const svg = d3.select('#map')
    .attr('viewBox', `0 0 ${width} ${height}`)
    .attr('preserveAspectRatio', 'xMidYMid meet');
  const projection = d3.geoNaturalEarth1()
    .scale(168)
    .translate([width / 2, height / 2 + 6]);
  const pathGen = d3.geoPath(projection);

  fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json')
    .then(r => r.json())
    .then(world => {
      const countries = topojson.feature(world, world.objects.countries).features;
      const g = svg.append('g');
      g.selectAll('path')
        .data(countries)
        .join('path')
        .attr('d', pathGen)
        .attr('class', d => {
          const t = tierFor(countFor(String(d.id)));
          return 'country' + (t ? ' ' + t : '');
        })
        .attr('data-id', d => String(d.id))
        .attr('data-name', d => d.properties.name)
        .on('click', function(event, d) {
          openSheet(String(d.id), d.properties.name);
        });

      document.getElementById('loading').style.display = 'none';
      document.getElementById('map').style.display = 'block';

      updateStats();
      updateChips();
    })
    .catch(() => {
      document.getElementById('loading').innerHTML = 'Could not load the world map';
    });

  // ── Bottom sheet ──────────────────────────────────────
  let currentCountry = null;

  function openSheet(id, name) {
    currentCountry = { id, name };
    document.getElementById('sheet-country').textContent = name;
    hideAddForm();
    renderSheetContent();
    document.getElementById('sheet').classList.add('show');
    document.getElementById('sheet-backdrop').classList.add('show');
  }

  function closeSheet() {
    document.getElementById('sheet').classList.remove('show');
    document.getElementById('sheet-backdrop').classList.remove('show');
    hideAddForm();
    currentCountry = null;
  }

  function renderSheetContent() {
    if (!currentCountry) return;
    const { id } = currentCountry;
    const list = visitsFor(id);
    const count = list.length;

    document.getElementById('sheet-count-num').textContent = count;
    document.getElementById('sheet-count-label').textContent = count === 1 ? 'trip' : 'trips';

    const listEl = document.getElementById('visit-list');
    if (list.length === 0) {
      listEl.innerHTML = '<div class="empty-visits">No trips recorded yet</div>';
    } else {
      const sorted = [...list].sort((a, b) => {
        if (!a.date && !b.date) return 0;
        if (!a.date) return 1;
        if (!b.date) return -1;
        return b.date.localeCompare(a.date);
      });
      listEl.innerHTML = sorted.map(v => `
        <div class="visit-item">
          <div class="visit-item-info">
            <div class="visit-date${v.date ? '' : ' no-date'}">${v.date ? formatDate(v.date) : 'No date'}</div>
            ${v.note ? `<div class="visit-note">${escapeHtml(v.note)}</div>` : ''}
          </div>
          <button class="visit-delete" data-visit-id="${v.id}" aria-label="Remove trip">×</button>
        </div>
      `).join('');
      listEl.querySelectorAll('.visit-delete').forEach(btn => {
        btn.addEventListener('click', () => removeVisit(btn.getAttribute('data-visit-id')));
      });
    }
  }

  function formatDate(d) {
    if (!d) return '';
    const date = new Date(d + 'T00:00:00');
    if (isNaN(date.getTime())) return d;
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function addVisit(date, note) {
    if (!currentCountry) return;
    const { id, name } = currentCountry;
    visits.push({ id: gid(), countryId: id, countryName: name, date: date || '', note: note || '' });
    save();
    updateCountryPath(id);
    // pop animation
    const el = d3.select(`.country[data-id="${id}"]`);
    el.classed('just-added', true);
    setTimeout(() => el.classed('just-added', false), 500);
    renderSheetContent();
    updateStats();
    updateChips();
  }

  function removeVisit(vid) {
    const v = visits.find(x => x.id === vid);
    if (!v) return;
    visits = visits.filter(x => x.id !== vid);
    save();
    updateCountryPath(v.countryId);
    renderSheetContent();
    updateStats();
    updateChips();
  }

  function showAddForm() {
    document.getElementById('add-form').classList.add('open');
    document.getElementById('add-visit-btn').style.display = 'none';
    const today = new Date();
    const dateStr = today.toISOString().slice(0, 10);
    document.getElementById('visit-date').value = dateStr;
    document.getElementById('visit-note').value = '';
    setTimeout(() => document.getElementById('visit-note').focus(), 100);
  }
  function hideAddForm() {
    document.getElementById('add-form').classList.remove('open');
    document.getElementById('add-visit-btn').style.display = 'block';
  }

  document.getElementById('sheet-close').addEventListener('click', closeSheet);
  document.getElementById('sheet-backdrop').addEventListener('click', closeSheet);
  document.getElementById('add-visit-btn').addEventListener('click', showAddForm);
  document.getElementById('cancel-visit').addEventListener('click', hideAddForm);
  document.getElementById('save-visit').addEventListener('click', () => {
    const date = document.getElementById('visit-date').value;
    const note = document.getElementById('visit-note').value.trim();
    addVisit(date, note);
    hideAddForm();
  });

  // Escape key closes sheet
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && document.getElementById('sheet').classList.contains('show')) {
      closeSheet();
    }
  });

  // ── Stats & chips ─────────────────────────────────────
  function updateStats() {
    const uniqueCountries = new Set(visits.map(v => String(v.countryId)));
    const totalTrips = visits.length;
    const contSet = new Set();
    uniqueCountries.forEach(id => {
      const c = idToContinent[id];
      if (c) contSet.add(c);
    });
    document.getElementById('country-count').textContent = uniqueCountries.size;
    document.getElementById('trip-count').textContent = totalTrips;
    document.getElementById('continent-count').textContent = contSet.size;
  }

  function updateChips() {
    const section = document.getElementById('recent-section');
    const list = document.getElementById('chip-list');
    const countEl = document.getElementById('recent-count');

    // Group by country
    const grouped = {};
    visits.forEach(v => {
      const key = String(v.countryId);
      if (!grouped[key]) grouped[key] = { id: key, name: v.countryName, count: 0, latestDate: '' };
      grouped[key].count++;
      if (v.date > grouped[key].latestDate) grouped[key].latestDate = v.date;
    });

    const arr = Object.values(grouped);
    if (arr.length === 0) {
      section.style.display = 'none';
      return;
    }
    section.style.display = 'block';
    countEl.textContent = arr.length + ' countr' + (arr.length === 1 ? 'y' : 'ies');
    // sort: most-recent latestDate first, then by count desc
    arr.sort((a, b) => {
      if (a.latestDate && b.latestDate && a.latestDate !== b.latestDate) return b.latestDate.localeCompare(a.latestDate);
      if (a.latestDate && !b.latestDate) return -1;
      if (!a.latestDate && b.latestDate) return 1;
      return b.count - a.count;
    });
    list.innerHTML = arr.map(c =>
      `<span class="chip" data-country-id="${escapeHtml(c.id)}" data-country-name="${escapeHtml(c.name)}"><span class="chip-dot"></span>${escapeHtml(c.name)}<span class="chip-count">${c.count}</span></span>`
    ).join('');

    // Click chip to open its sheet
    list.querySelectorAll('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        openSheet(chip.getAttribute('data-country-id'), chip.getAttribute('data-country-name'));
      });
    });
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  // ── Reset ─────────────────────────────────────────────
  document.getElementById('reset').addEventListener('click', () => {
    if (!confirm('Delete all trips? This cannot be undone.')) return;
    visits = [];
    save();
    d3.selectAll('.country').classed('v1 v2 v3 v4', false);
    updateStats();
    updateChips();
  });
})();
</script>

</body>
</html>
